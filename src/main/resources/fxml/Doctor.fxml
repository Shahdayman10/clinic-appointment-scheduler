<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.clinic.app.Controllers.DoctorController"
            stylesheets="@../css/doctor.css">

    <!-- Top Bar -->
    <top>
        <HBox fx:id="topBar" prefHeight="70" alignment="CENTER_LEFT" styleClass="top-bar">
            <Label text="Clinic Appointment Scheduler" styleClass="platform-name" />
            <Region HBox.hgrow="ALWAYS" />

            <!-- Settings: Exit only -->
            <Button styleClass="settings-button" onAction="#exitApp">
                <graphic>
                    <ImageView fitHeight="24" fitWidth="24">
                        <Image url="@../icons/logout.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <HBox fx:id="mainContainer"
              spacing="0"
              fillHeight="true"
              styleClass="main-container doctors-accent"
              BorderPane.alignment="CENTER">

            <!-- Sidebar -->
            <VBox fx:id="sidebar" styleClass="sidebar">
                <BorderPane VBox.vgrow="ALWAYS">
                    <center>
                        <VBox fx:id="sidebarContent" spacing="15" styleClass="sidebar-content">
                            <Button fx:id="btnDashboard" text="Home"
                                    styleClass="sidebar-button"
                                    onAction="#showDashboard">
                                <graphic>
                                    <ImageView fitHeight="24" fitWidth="24">
                                        <Image url="@../icons/dashboard.png"/>
                                    </ImageView>
                                </graphic>
                            </Button>

                            <Button fx:id="btnPatients" text="Patients"
                                    styleClass="sidebar-button"
                                    onAction="#showPatients">
                                <graphic>
                                    <ImageView fitHeight="24" fitWidth="24">
                                        <Image url="@../icons/patient.png"/>
                                    </ImageView>
                                </graphic>
                            </Button>

                            <Button fx:id="btnDoctors" text="Doctors"
                                    styleClass="sidebar-button"
                                    onAction="#showDoctors">
                                <graphic>
                                    <ImageView fitHeight="24" fitWidth="24">
                                        <Image url="@../icons/doctor_stethoscope.png"/>
                                    </ImageView>
                                </graphic>
                            </Button>

                            <Button fx:id="btnAppointments" text="Appointments"
                                    styleClass="sidebar-button"
                                    onAction="#showAppointments">
                                <graphic>
                                    <ImageView fitHeight="24" fitWidth="24">
                                        <Image url="@../icons/appointments.png"/>
                                    </ImageView>
                                </graphic>
                            </Button>

                            <Button fx:id="btnSchedule" text="Schedule"
                                    styleClass="sidebar-button"
                                    onAction="#showSchedule">
                                <graphic>
                                    <ImageView fitHeight="24" fitWidth="24">
                                        <Image url="@../icons/schedule.png"/>
                                    </ImageView>
                                </graphic>
                            </Button>

                        </VBox>
                    </center>

                    <!-- Need Help أسفل -->
                    <bottom>
                        <VBox styleClass="contact-container" spacing="5" BorderPane.alignment="CENTER">
                            <Label text="Need Help?" styleClass="contact-title"/>
                            <Label text="Contact: support@clinic.com" styleClass="contact-info"/>
                            <Label text="Phone: +123 456 7890" styleClass="contact-info"/>
                            <BorderPane.margin><Insets bottom="10"/></BorderPane.margin>
                        </VBox>
                    </bottom>
                </BorderPane>
            </VBox>

            <!-- Content Area داخل ScrollPane -->
            <ScrollPane fx:id="contentScroll"
                        fitToWidth="true"
                        fitToHeight="false"
                        pannable="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        HBox.hgrow="ALWAYS"
                        VBox.vgrow="ALWAYS"
                        styleClass="content-scroll">

                <content>
                    <VBox fx:id="contentArea"
                          fillWidth="true"
                          styleClass="content-area doctor-container">

                        <!-- Section Header -->
                        <VBox styleClass="section-header">
                            <Label text="Doctor Management" styleClass="section-title"/>
                        </VBox>

                        <!-- Form Container -->
                        <VBox styleClass="form-container">
                            <Label text="Doctor Information" styleClass="form-title"/>

                            <GridPane styleClass="form-grid" hgap="15" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints prefWidth="150" halignment="RIGHT"/>
                                    <ColumnConstraints prefWidth="300" halignment="LEFT"/>
                                    <ColumnConstraints prefWidth="150" halignment="RIGHT"/>
                                    <ColumnConstraints prefWidth="300" halignment="LEFT"/>
                                </columnConstraints>

                                <rowConstraints>
                                    <RowConstraints prefHeight="40"/>
                                    <RowConstraints prefHeight="40"/>
                                    <RowConstraints prefHeight="40"/>
                                    <RowConstraints prefHeight="40"/>
                                    <RowConstraints prefHeight="60"/>
                                </rowConstraints>

                                <!-- Row 1 -->
                                <Label text="Name:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtName" styleClass="form-input" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Specialty:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                <TextField fx:id="txtSpecialty" styleClass="form-input" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                                <!-- Row 2 -->
                                <Label text="Phone:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtPhone" styleClass="form-input" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Email:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                <TextField fx:id="txtEmail" styleClass="form-input" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                                <!-- Row 3 -->
                                <Label text="Availability:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <CheckBox fx:id="chkAvailable" text="Available" styleClass="form-checkbox" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <!-- Row 4 -->
                                <Label text="Notes:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <TextArea fx:id="taNotes" styleClass="form-textarea" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowSpan="1"/>

                                <!-- Row 5: Buttons -->
                                <HBox spacing="15" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="3">
                                    <Button text="Save" styleClass="save-button" onAction="#saveDoctor"/>
                                    <Button text="Clear" styleClass="clear-button" onAction="#clearForm"/>
                                    <Button text="Delete" styleClass="delete-button" onAction="#deleteDoctor"/>
                                </HBox>
                            </GridPane>
                        </VBox>

                        <!-- Search and Filter Container -->
                        <VBox styleClass="search-sort-container" spacing="10">
                            <Label text="Search and Filter Doctors" styleClass="search-title"/>

                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="search-controls">
                                <Label text="Search:" styleClass="search-label"/>
                                <TextField fx:id="txtSearch" promptText="Search by name, specialty, phone, email..."
                                           styleClass="search-field" HBox.hgrow="ALWAYS"/>
                                <Button text="Search" styleClass="search-button" onAction="#handleSearch"/>
                                <Button text="Clear" styleClass="clear-search-button" onAction="#handleClearSearch"/>
                            </HBox>

                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-controls">
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Total Doctors: " styleClass="total-label"/>
                                <Label fx:id="lblTotalDoctors" text="0" styleClass="total-count"/>
                            </HBox>
                        </VBox>

                        <!-- Doctors List -->
                        <VBox styleClass="table-container">
                            <Label text="Doctor Records" styleClass="table-title"/>

                            <TableView fx:id="doctorsTable" styleClass="table-view" onMouseClicked="#handleRowClick">
                                <columns>
                                    <TableColumn text="ID" prefWidth="70"/>
                                    <TableColumn text="Name" prefWidth="180"/>
                                    <TableColumn text="Specialty" prefWidth="150"/>
                                    <TableColumn text="Phone" prefWidth="120"/>
                                    <TableColumn text="Email" prefWidth="180"/>
                                    <TableColumn text="Available" prefWidth="100"/>
                                    <TableColumn text="Actions" prefWidth="160"/>
                                </columns>
                            </TableView>
                        </VBox>

                    </VBox>
                </content>
            </ScrollPane>
        </HBox>
    </center>
</BorderPane>