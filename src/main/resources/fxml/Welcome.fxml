<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Ellipse?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="root" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.clinic.app.Controllers.WelcomeController" stylesheets="@../css/welcom.css">

    <!-- الخلفية -->
    <ImageView fx:id="backgroundImage" preserveRatio="false">
        <image>
            <Image url="@../images/clinic_bg.jpg"/>
        </image>
    </ImageView>

    <Rectangle fx:id="overlay" opacity="0.4" fill="BLACK" />

    <!-- المحتوى الرئيسي -->
    <VBox alignment="CENTER" spacing="40">
        <StackPane styleClass="content-frame">
           <Rectangle width="600" height="300" arcWidth="150" arcHeight="100" opacity="0.4"
           fill="linear-gradient(from 0% 0% to 100% 100%, #007ba7, #004f6e, #003851)"
           stroke="rgba(0, 79, 110, 0.6)" strokeWidth="1.5" />

            <!-- المحتوى الداخلي -->
            <VBox alignment="CENTER" spacing="40" styleClass="inner-content">
               <!-- النص الترحيبي -->
                <VBox alignment="CENTER" spacing="10">
                    <Text fx:id="welcomeText1" text="Welcome to" />
                    <Text fx:id="welcomeText2" text="Clinic Appointment Scheduler" />
                </VBox>

                <!-- أزرار الدخول والتسجيل -->
                <HBox alignment="CENTER" spacing="30">
                    <Button fx:id="loginButton" text="Login" styleClass="modern-button" onAction="#handleLogin" />
                    <Button fx:id="signupButton" text="Sign Up" styleClass="modern-button" onAction="#handleSignUp" />
                </HBox>
            </VBox>
        </StackPane>
    </VBox>

</StackPane>